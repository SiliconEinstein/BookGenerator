# 全部 LLM 调用统一走 LiteLLM 网关
LITELLM_PROXY_API_BASE=https://litellm.dp.tech
LITELLM_PROXY_API_KEY=your_litellm_proxy_key_here

# 模型覆盖（留空则使用 config/config.dev.yaml 中的默认值）
# LLM_WRITER_MODEL=cds/GPT-5.4
# LLM_REVIEWER_MODEL=claude-sonnet-4-6
# LLM_UTILITY_MODEL=gemini-3.1-pro-preview
# LLM_IMAGE_MODEL=sn/gemini-3-pro-image-preview

# 问答对检索（OpenSearch）
OPENSEARCH_HOST=your_opensearch_host_here
OPENSEARCH_USERNAME=your_opensearch_username_here
OPENSEARCH_PASSWORD=your_opensearch_password_here

# 百科检索
WIKI_SEARCH_API_BASE=https://literature-sage.test.bohrium.com
